#!/bin/bash
set -euo pipefail
cd -- "$(dirname -- "$0")"
version=$(cat VERSION)
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.-]+)?$ ]] || { echo "Invalid firmware VERSION" >&2; exit 1; }
revision=$(git rev-parse --short=12 HEAD)
suffix=""
git diff --quiet HEAD -- || suffix="-dirty"
printf '%s+g%s%s\n' "$version" "$revision" "$suffix"
